# ============================================================
# SERVER CONFIGURATION
# ============================================================
APP_HOST=0.0.0.0
APP_PORT=18427
FRONTEND_DIST_PATH=../frontend/dist
WORKERS=3

# ============================================================
# API KEYS
# ============================================================
# Generate strong values with: npm run generate:secrets
ADMIN_API_KEY=CHANGE_ME_32_CHAR_RANDOM_STRING
WEBUI_API_KEY=CHANGE_ME_32_CHAR_RANDOM_STRING
SECRET_KEY=CHANGE_ME_32_CHAR_RANDOM_STRING
ENCRYPTION_KEY=CHANGE_ME_32_CHAR_RANDOM_STRING
# Per-app keys are stored in the database, not in .env

# ============================================================
# MODEL CONFIGURATION (Stage 3 LLM - Qwen3.5-9B, auto-download)
# ============================================================
# Set MODEL_PATH to "auto" to auto-download on first use, or provide a full
# path to an existing GGUF file.
MODEL_PATH=auto
MODEL_PRIMARY_REPO=bartowski/Qwen_Qwen3.5-9B-GGUF
MODEL_FALLBACK_REPO=lmstudio-community/Qwen3.5-9B-GGUF
MODEL_FILENAME=Qwen_Qwen3.5-9B-Q4_K_M.gguf
MODEL_DIR=./models
MODEL_CONTEXT_SIZE=16384
MODEL_THREADS=auto
MODEL_BATCH_SIZE=512
MODEL_MAX_TOKENS=10
MODEL_CACHE_TYPE_K=q8_0
MODEL_CACHE_TYPE_V=q8_0
MODEL_FLASH_ATTN=true
MODEL_MLOCK=true
MODEL_IDLE_TIMEOUT_SECONDS=300

# Hugging Face endpoints, probed in order (primary, mirror, ModelScope)
HF_ENDPOINT=https://huggingface.co
HF_MIRROR=https://hf-mirror.com
MODELSCOPE_ENDPOINT=https://www.modelscope.cn

# ============================================================
# STAGE 1: FAST PATH (safe word list)
# ============================================================
SAFE_WORD_LIST_PATH=./data/safe_words.txt
SAFE_WORD_ENABLED=true

# ============================================================
# STAGE 2: DETECTORS (toggles and weights)
# ============================================================
ENABLE_BADWORDS_PY=true
ENABLE_PROFANITE=true
ENABLE_GLIN_PROFANITY=true
ENABLE_SAFETEXT=true
ENABLE_SENSITIVE_WORD_FILTER_CN=true
ENABLE_PROFANITY_FILTER=true
ENABLE_GANGAJAL=true
ENABLE_PYPROFANE=true
# External sensitive-stop-words submodule (loaded from SENSITIVE_STOP_WORDS_DIR)
ENABLE_SENSITIVE_STOP_WORDS=true
SENSITIVE_STOP_WORDS_DIR=./data/sensitive-stop-words
# Additional raw Chinese sensitive-word lists (newline-delimited txt). These
# are matched by the service's own algorithms (Aho-Corasick); the subrepos do
# not ship Python bindings. Fetch all with: git submodule update --init
SENSITIVE_WORD_DATA_DICT=./data/sensitive-word-data/src/main/resources/sensitive_word_dict.txt
SENSITIVE_LEXICON_DIR=./data/sensitive-lexicon/Vocabulary
SENSITIVE_DICT_PATH=./data/sensitive/dict/dict.txt
# Per-category toggles for the sensitive-stop-words blocking lists
ENABLE_SENSITIVE_STOP_WORDS_POLITICAL=true
ENABLE_SENSITIVE_STOP_WORDS_PORN=true
ENABLE_SENSITIVE_STOP_WORDS_GUN=true
ENABLE_SENSITIVE_STOP_WORDS_AD=true
ENABLE_SENSITIVE_STOP_WORDS_URL=true
# Minimum term length for a sensitive-list match to hard-block (single CJK
# chars are common in benign text)
SENSITIVE_MIN_WORD_LENGTH=2

# Severity-aware phrase detection (critical phrases table + PhraseDetector)
CRITICAL_PHRASES_DB_PATH=./data/critical_phrases.db
ENABLE_PHRASE_DETECTOR=true
SEVERITY_HARD_BLOCK_THRESHOLD=5
REVIEW_ESCALATION_THRESHOLD=40

# Multi-language package handling
ML_REVIEW_MODE=false
# Benign words packages misflag (e.g. Turkish "cok" = "very"), stripped before
# package matching
ML_BENIGN_WORD_EXCLUSIONS=cok

# Detector weights used by the suspicion score
WEIGHT_DETECTOR_BADWORDS=25
WEIGHT_DETECTOR_PROFANITE=20
WEIGHT_DETECTOR_GLIN=20
WEIGHT_DETECTOR_AHO=30
WEIGHT_DETECTOR_BKTREE=20
WEIGHT_DETECTOR_METAPHONE=15

# Legacy detector tuning
BLOOM_FILTER_CAPACITY=1000000
BLOOM_FILTER_ERROR_RATE=0.001
SPAM_CACHE_SIZE=10000
SPAM_CACHE_TTL_SECONDS=60
FUZZY_MAX_DISTANCE=2

# ============================================================
# STAGE 2: SEMANTIC SIMILARITY (SentenceTransformers + Faiss)
# ============================================================
SEMANTIC_ENABLED=true
SEMANTIC_MODEL=paraphrase-multilingual-MiniLM-L12-v2
SEMANTIC_INDEX_DIR=./semantic/
SEMANTIC_SIMILARITY_THRESHOLD=0.65
SEMANTIC_FORCE_LLM_THRESHOLD=0.80
SEMANTIC_TOP_K=5

WEIGHT_SEMANTIC_POLITICAL=35
WEIGHT_SEMANTIC_VIOLENCE=40
WEIGHT_SEMANTIC_SEXUAL=30
WEIGHT_SEMANTIC_HATE=35
WEIGHT_SEMANTIC_PII=25
WEIGHT_SEMANTIC_ADS=15

# ============================================================
# STAGE 2: USER PROFILING (91-day rolling window with archive)
# ============================================================
USER_PROFILING_ENABLED=true
USER_DB_PATH=./data/users.db
USER_ARCHIVE_DB_PATH=./data/archive.db
USER_RATIO_THRESHOLD=0.3
USER_SCORE_MODIFIER=20
USER_WINDOW_DAYS=91

# ============================================================
# STAGE 2: SUSPICION SCORING
# ============================================================
WEIGHT_USER=20
SCORE_WEIGHTS_CACHE_TTL_SECONDS=300

# ============================================================
# STAGE 3: LLM TRIGGER POLICY
# ============================================================
AI_TARGET_PERCENTAGE=5
FORCE_LLM_ON_SEMANTIC_HIGH=true
FORCE_LLM_ON_USER_RATIO_HIGH=true
LLM_RESPONSE_TIMEOUT_SECONDS=30

# ============================================================
# FEEDBACK AND AUTO-TUNING
# ============================================================
FEEDBACK_DB_PATH=./data/feedback.db
AUTO_TUNING_ENABLED=true
WEIGHT_DECAY_HALF_LIFE_DAYS=30
AUTO_TUNING_BATCH_HOUR=0

# ============================================================
# RUNTIME SETTINGS PERSISTENCE
# ============================================================
SETTINGS_DB_PATH=./data/settings.db
SETTINGS_CACHE_TTL_SECONDS=60

# ============================================================
# DATA EXPORT
# ============================================================
EXPORT_TEMP_DIR=./exports
EXPORT_RETENTION_DAYS=7

# ============================================================
# SECURITY
# ============================================================
# Rate Limiting (Redis C client or C-accelerated)
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# Optional Redis URI for cross-worker rate limiting (slowapi storage) and
# cross-worker result-cache invalidation (pub/sub). Leave empty to disable.
REDIS_URI=

# Allowed CORS Origins
ALLOWED_ORIGINS=http://localhost:18427,http://127.0.0.1:18427

# ============================================================
# LOGGING (C-accelerated JSON)
# ============================================================
LOG_FILE_PATH=./logs/moderation.log
LOG_LEVEL=INFO
LOG_MAX_BYTES=104857600
LOG_BACKUP_COUNT=10
LOG_RETENTION_DAYS=30

# ============================================================
# CUSTOM WORD STORAGE (SQLite - C implementation)
# ============================================================
CUSTOM_WORDS_STORAGE=sqlite
CUSTOM_WORDS_PATH=./data/custom_words.db

# ============================================================
# WEB UI
# ============================================================
WEBUI_ENABLED=true
WEBUI_HOST=127.0.0.1
WEBUI_PORT=5173

# ============================================================
# MONITORING (Prometheus)
# ============================================================
METRICS_ENABLED=true
METRICS_PORT=9090
METRICS_COLLECTION_INTERVAL_SECONDS=60

# ============================================================
# PERFORMANCE
# ============================================================
REQUEST_TIMEOUT_SECONDS=30
MAX_BATCH_SIZE=100

# ============================================================
# RESULT CACHE (LRU with TTL)
# ============================================================
CACHE_MAX_SIZE=500
CACHE_TTL_SECONDS=60

# ============================================================
# CONCURRENCY
# ============================================================
DETECTOR_THREAD_POOL_SIZE=4

# ============================================================
# NOTES
# ============================================================
# The safetext, sensitive-word-filter-cn, and profanity-filter2 packages are
# guard-wired but not installable from public PyPI; they activate only when a
# working index provides them (add via: uv add <package>==<version>).
# scheckbl and valx are not wired (their documented APIs do not exist) and
# datasketch is not wired (MinHash semantic similarity needs a toxic-signature
# database).
