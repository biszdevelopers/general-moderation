{
    "name": "general-moderation-web-ui",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "preview": "vite preview",
        "lint": "oxlint .",
        "format": "oxfmt --config .oxfmt.json src --write",
        "format:check": "oxfmt --config .oxfmt.json src --check",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@ant-design/icons": "6.3.2",
        "antd": "^6.6.0",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "react-router-dom": "^7.18.2"
    },
    "devDependencies": {
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.4",
        "@types/react-router-dom": "5.3.3",
        "@vitejs/plugin-react": "^6.0.5",
        "jsdom": "30.0.1",
        "oxfmt": "^0.63.0",
        "oxlint": "^1.78.0",
        "typescript": "6.0.3",
        "vite": "^8.2.1",
        "vitest": "4.1.10"
    }
}
