{
    "name": "general-moderation",
    "private": true,
    "version": "1.0.0",
    "scripts": {
        "start": "npm run start:prod",
        "start:dev": "concurrently \"npm run backend\" \"npm run frontend\"",
        "start:prod": "npm run backend:prod",
        "backend": "node scripts/dev.mjs backend",
        "backend:dev": "node scripts/dev.mjs backend",
        "backend:prod": "node scripts/dev.mjs backend-prod",
        "frontend": "cd frontend && npm run dev",
        "frontend:dev": "cd frontend && npm run dev",
        "install:all": "node scripts/dev.mjs install",
        "install:backend": "node scripts/dev.mjs install-backend",
        "download": "node scripts/dev.mjs download",
        "generate:secrets": "node scripts/dev.mjs gen-secrets",
        "format": "node scripts/dev.mjs format",
        "format:backend": "node scripts/dev.mjs format-backend",
        "lint": "node scripts/dev.mjs lint",
        "lint:backend": "node scripts/dev.mjs lint-backend",
        "build": "cd frontend && npm run build",
        "build:prod": "cd frontend && npm run build -- --mode production",
        "docs:dev": "cd docs && npm run docs:dev",
        "docs:build": "cd docs && npm run docs:build",
        "test": "cd backend && uv run python -m pytest tests -n auto",
        "test:unit": "cd backend && uv run python -m pytest tests/unit -n auto",
        "test:integration": "cd backend && uv run python -m pytest tests/integration -n auto",
        "test:e2e": "cd backend && uv run python -m pytest tests/e2e -n auto",
        "test:phase2": "cd backend && uv run python -m pytest tests -k phase2 -n auto",
        "test:serial": "cd backend && uv run python -m pytest tests"
    },
    "devDependencies": {
        "concurrently": "9.1.0"
    },
    "engines": {
        "node": ">=20.19.0",
        "npm": ">=10.0.0"
    }
}
